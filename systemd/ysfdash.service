[Unit]
Description=YSF Reflector dashboard
After=network.target

[Service]
User=ysfdash
Group=adm
ExecStart=/usr/bin/python3 /opt/ysfdash/ysfdash.py --log-dir /var/log/YSFReflector --host 0.0.0.0 --port 8080
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
