[Unit]
Description=YSF reflector text message decoder (broadcast messages only)
After=network.target

[Service]
User=ysfdash
Group=ysfdash
ExecStart=/usr/bin/python3 /opt/ysfdash/ysfmsgd.py --port 42002 --out /var/lib/ysfradio/messages.json --news-out /var/lib/ysfradio/newsreq.json --board-out /var/lib/ysfradio/newsboard.json --board-room-id 00000
Restart=on-failure
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_PACKET AF_UNIX
ReadWritePaths=/var/lib/ysfradio

[Install]
WantedBy=multi-user.target
